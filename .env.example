# FRAUDNET AI Environment Variables Template
# Copy this file to .env and configure your variables

# Groq Cloud API Key for AI Agent & Forensic Chat
# Obtain free or production key from https://console.groq.com/keys
GROQ_API_KEY=

# Groq Model Selection (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1500

# Streamlit Configuration (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME_BASE=dark

